  "beats": [
    {
      "text": "A sogra foi pra um cruzeiro e deixou a cachorra com o Tavinho.",
      "speed": 1,
      "shot": "living",
      "event": "hook",
      "highlight": [
        "sogra",
        "cruzeiro"
      ],
      "tone": "chocado, rápido",
      "exaggeration": 1.35,
      "pauseBefore": 0
    },
    {
      "text": "Ela fugiu em dez minutos.",
      "speed": 1,
      "shot": "street",
      "event": "punch",
      "highlight": [
        "fugiu",
        "dez"
      ],
      "tone": "seco",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "E quem decide o que ele faz, dia após dia, é você.",
      "speed": 1,
      "shot": "home",
      "event": "you",
      "highlight": [
        "você"
      ],
      "tone": "cúmplice, direto pra quem assiste",
      "exaggeration": 1.1,
      "pauseBefore": 0
    },
    {
      "text": "O problema: a sogra volta em quinze dias. E quer foto da Princesa todo dia.",
      "speed": 1,
      "shot": "living",
      "event": "stakes",
      "highlight": [
        "problema",
        "quinze",
        "foto"
      ],
      "tone": "tenso",
      "exaggeration": 1.1,
      "pauseBefore": 0
    },
    {
      "text": "Tudo começou com uma lista na geladeira.",
      "speed": 1,
      "shot": "note",
      "event": "back",
      "highlight": [
        "lista"
      ],
      "tone": "contando história, mais calmo",
      "exaggeration": 0.9,
      "pauseBefore": 0
    },
    {
      "text": "Ração importada, música clássica e escovar os dentes da Princesa.",
      "speed": 1,
      "shot": "note",
      "event": "rant",
      "highlight": [
        "ração",
        "dentes"
      ],
      "tone": "listando, cada vez mais incrédulo",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Ela usa casaco de oncinha e um laço gigante.",
      "speed": 1,
      "shot": "living",
      "event": "rant2",
      "highlight": [
        "oncinha",
        "laço"
      ],
      "tone": "debochado",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Aí chegou o lanche dele.",
      "speed": 1,
      "shot": "street",
      "event": "lunch",
      "highlight": [
        "lanche"
      ],
      "tone": "feliz, inocente",
      "exaggeration": 1,
      "pauseBefore": 0
    },
    {
      "text": "Mas ele deixou o portão aberto.",
      "speed": 1,
      "shot": "street",
      "event": "card",
      "highlight": [
        "portão"
      ],
      "tone": "revelação: firme",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "A Princesa saiu correndo atrás do motoboy.",
      "speed": 1,
      "shot": "street",
      "event": "run",
      "highlight": [
        "princesa",
        "motoboy"
      ],
      "tone": "rápido, caos",
      "exaggeration": 1.3,
      "pauseBefore": 0
    },
    {
      "text": "O Tavinho correu dois quarteirões e teve que sentar.",
      "speed": 1,
      "shot": "street",
      "event": "sit",
      "highlight": [
        "dois",
        "sentar"
      ],
      "tone": "deadpan",
      "exaggeration": 1,
      "pauseBefore": 0
    },
    {
      "text": "Segue o Tavinho. São quinze dias, e piora.",
      "speed": 1,
      "shot": "street",
      "event": "follow",
      "highlight": [
        "tavinho",
        "piora"
      ],
      "tone": "rápido, simpático",
      "exaggeration": 1.1,
      "pauseBefore": 0
    },
    {
      "text": "Mas chega a primeira mensagem da sogra: cadê a foto da minha princesa?",
      "speed": 1,
      "shot": "celestechat",
      "event": "twist",
      "highlight": [
        "foto"
      ],
      "tone": "choque, virada; imita a sogra no fim",
      "exaggeration": 1.3,
      "pauseBefore": 0
    },
    {
      "text": "Chance de ela não perceber: quatro por cento.",
      "speed": 1,
      "shot": "home",
      "event": "percent",
      "highlight": [
        "quatro"
      ],
      "tone": "deadpan, piada seca",
      "exaggeration": 1,
      "pauseBefore": 0
    },
    {
      "text": "Dia um: que foto ele manda?",
      "speed": 1,
      "shot": "vote",
      "event": "mission",
      "highlight": [
        "dia",
        "um"
      ],
      "tone": "energia de apresentador",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Uma foto antiga: é perfeita. Mas a Princesa está com o laço de Natal.",
      "speed": 1,
      "shot": "vote",
      "event": "video",
      "highlight": [
        "antiga",
        "natal"
      ],
      "tone": "vendendo a opção, rápido",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Ou uma almofada branca com o laço, de longe: é de hoje. Mas a almofada não tem cara.",
      "speed": 1,
      "shot": "vote",
      "event": "vo",
      "highlight": [
        "almofada",
        "cara"
      ],
      "tone": "malandro, depois alerta no final",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Você decide: foto antiga ou almofada?",
      "speed": 1,
      "shot": "vote",
      "event": "decide",
      "highlight": [
        "antiga",
        "almofada"
      ],
      "tone": "pergunta direta, empolgado",
      "exaggeration": 1.2,
      "pauseBefore": 0
    }
  ]
