  "beats": [
    {
      "text": "A sogra deixou a cachorra com o Tavinho.",
      "speed": 1.0,
      "shot": "living",
      "event": "hook",
      "highlight": [
        "sogra",
        "cachorra"
      ],
      "tone": "chocado, rápido",
      "exaggeration": 1.35,
      "pauseBefore": 0
    },
    {
      "text": "Ela fugiu em dez minutos.",
      "speed": 1.0,
      "shot": "street",
      "event": "punch",
      "highlight": [
        "fugiu",
        "dez"
      ],
      "tone": "seco, pausa curta antes",
      "exaggeration": 1.25,
      "pauseBefore": 0
    },
    {
      "text": "E quem decide como ele acha a Princesa é você.",
