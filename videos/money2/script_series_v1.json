{
  "id": "money2",
  "title": "Banks create money out of thin air. Here's how.",
  "ep": 2,
  "lang": "en-us",
  "voice": {
    "am_adam": 0.7,
    "am_michael": 0.3
  },
  "leadIn": 0.05,
