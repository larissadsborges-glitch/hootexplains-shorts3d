      "shot": "celestechat",
      "event": "noreturn",
      "highlight": [
        "cinco"
      ],
      "tone": "devagar, sem esperança",
      "exaggeration": 1.1,
      "pauseBefore": 0
    },
    {
      "text": "Chance de achar a Princesa: quatro por cento.",
      "speed": 1.0,
      "shot": "home",
      "event": "percent",
      "highlight": [
        "quatro"
      ],
      "tone": "deadpan, piada seca",
      "exaggeration": 1.0,
      "pauseBefore": 0
    },
    {
      "text": "Missão um: como ele procura?",
      "speed": 1.0,
      "shot": "vote",
      "event": "mission",
      "highlight": [
        "missão"
      ],
      "tone": "energia de apresentador",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "No grupo do bairro: é rápido. Mas a sogra está no grupo.",
      "speed": 1.0,
      "shot": "vote",
      "event": "video",
      "highlight": [
        "grupo",
        "sogra"
      ],
      "tone": "vendendo a opção, rápido",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Ou com uma salsicha: a Princesa ama salsicha. Mas os cachorros do bairro também.",
