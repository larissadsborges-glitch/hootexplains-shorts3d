  "hook": {
    "line1": "WHY IS YOUR MONEY",
    "line2": "WORTH LESS EVERY YEAR?",
    "top": "14%"
  },
  "outro": {
    "line1": "IS YOUR SAVINGS",
    "line2": "BEATING 3.7%?",
    "top": "11%"
