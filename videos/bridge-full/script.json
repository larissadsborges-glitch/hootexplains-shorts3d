      "speed": 1.15,
      "shot": "recap",
      "event": "recap",
      "highlight": [
        "beams",
        "piers",
        "piles",
        "joints",
        "guard",
        "rails"
      ]
    },
    {
      "act": 7,
      "text": "That's how you build a bridge that won't fall.",
