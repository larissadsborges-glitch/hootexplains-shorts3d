      "shot": "petshop",
      "event": "truth",
      "highlight": [
        "igual"
      ],
      "tone": "mais baixo, esperançoso",
      "exaggeration": 1.0,
      "pauseBefore": 0
    },
    {
      "text": "Mas a sogra manda: me manda um vídeo da minha princesa.",
      "speed": 1.0,
      "shot": "celestechat",
      "event": "twist",
      "highlight": [
        "sogra",
        "princesa"
      ],
      "tone": "choque, virada da história",
      "exaggeration": 1.3,
      "pauseBefore": 0
    },
    {
      "text": "Ele tem cinco minutos.",
