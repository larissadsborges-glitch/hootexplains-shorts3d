      "shot": "vote",
      "event": "vo",
      "highlight": [
        "salsicha"
      ],
      "tone": "carinhoso, depois alerta no final",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Você decide: grupo ou salsicha?",
      "speed": 1.0,
      "shot": "vote",
      "event": "decide",
      "highlight": [
        "grupo",
        "salsicha"
      ],
      "tone": "pergunta direta, empolgado",
      "exaggeration": 1.2,
      "pauseBefore": 0
    }
  ]
