      "shot": "note",
      "event": "rant",
      "highlight": [
        "princesa"
      ],
      "tone": "deadpan, listando",
      "exaggeration": 1.0,
      "pauseBefore": 0
    },
    {
      "text": "Ela usa casaco de oncinha e um laço gigante.",
      "speed": 1.0,
      "shot": "living",
      "event": "rant2",
      "highlight": [
        "oncinha",
        "laço"
      ],
      "tone": "debochado",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Aí chegou o lanche dele.",
      "speed": 1.0,
      "shot": "street",
      "event": "lunch",
      "highlight": [
        "lanche"
      ],
      "tone": "animado",
      "exaggeration": 1.1,
      "pauseBefore": 0
    },
    {
      "text": "Mas ele deixou o portão aberto.",
      "speed": 1.0,
      "shot": "street",
      "event": "card",
      "highlight": [
        "portão"
      ],
      "tone": "revelação: firme",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "A Princesa saiu correndo atrás do motoboy.",
      "speed": 1.0,
      "shot": "street",
      "event": "run",
      "highlight": [
        "princesa"
      ],
      "tone": "rápido",
      "exaggeration": 1.25,
      "pauseBefore": 0
    },
    {
      "text": "O Tavinho correu dois quarteirões e teve que sentar.",
      "speed": 1.0,
      "shot": "street",
      "event": "sit",
      "highlight": [
        "dois",
        "sentar"
      ],
      "tone": "construindo até a piada",
      "exaggeration": 1.2,
      "pauseBefore": 0
    },
    {
      "text": "Segue o Tavinho. Ele precisa de ajuda.",
